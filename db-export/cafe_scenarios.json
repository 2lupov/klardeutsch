[{"id":"81c06c9f-a4f1-4bef-be86-6b0e97449bf9","barista_line":"Zum Mitnehmen oder hier trinken?","hint_ru":"С собой или здесь?","hint_uk":"Із собою чи тут?","options":[{"text": "Zum Hier trinken, bitte.", "type": "perfect", "feedback_ru": "Точно в цель! Звучит натурально 🎯", "feedback_uk": "Точно в ціль! Звучить природно 🎯"}, {"text": "Ich beabsichtige, den Kaffee in Ihrem Etablissement zu konsumieren.", "type": "formal", "feedback_ru": "Ты случайно не профессор? 🎓", "feedback_uk": "Ти випадково не професор? 🎓"}, {"text": "Hier.", "type": "rude", "feedback_ru": "Одно слово — маловато 😤", "feedback_uk": "Одне слово — замало 😤"}],"timer_sec":10,"level":"A1","sort_order":3,"created_at":"2026-03-03T09:38:43.464195+00:00","target_language":"de"}, {"id":"99e199aa-e616-4e74-96b5-f2cf61e1e4ae","barista_line":"Das macht drei fünfzig.","hint_ru":"С вас 3,50€","hint_uk":"З вас 3,50€","options":[{"text": "Hier, stimmt so!", "type": "perfect", "feedback_ru": "Идеально! Чаевые включены 💶", "feedback_uk": "Ідеально! Чайові включені 💶"}, {"text": "Ich überreiche Ihnen hiermit den geforderten Betrag.", "type": "formal", "feedback_ru": "Ты в банке или в кафе? 🏦", "feedback_uk": "Ти в банку чи в кафе? 🏦"}, {"text": "Teuer.", "type": "rude", "feedback_ru": "Комментировать цену — не круто 😒", "feedback_uk": "Коментувати ціну — не круто 😒"}],"timer_sec":10,"level":"A1","sort_order":4,"created_at":"2026-03-03T09:38:43.464195+00:00","target_language":"de"}, {"id":"d728e310-1d00-4f25-b803-4abee7817459","barista_line":"Möchten Sie Milch dazu?","hint_ru":"Хотите молоко?","hint_uk":"Бажаєте молока?","options":[{"text": "Ja, mit Hafermilch bitte.", "type": "perfect", "feedback_ru": "Супер! Как настоящий берлинец ☕", "feedback_uk": "Супер! Як справжній берлінець ☕"}, {"text": "Ich würde sehr gerne Milch zu meinem Kaffee hinzufügen lassen.", "type": "formal", "feedback_ru": "Это сочинение, а не кафе 📝", "feedback_uk": "Це твір, а не кафе 📝"}, {"text": "Milch, ja.", "type": "rude", "feedback_ru": "Коротко и сухо — не лучший тон 😕", "feedback_uk": "Коротко і сухо — не найкращий тон 😕"}],"timer_sec":10,"level":"A1","sort_order":2,"created_at":"2026-03-03T09:38:43.464195+00:00","target_language":"de"}, {"id":"484452ac-845d-4960-863c-7bde0ebe90a4","barista_line":"Darf es sonst noch etwas sein?","hint_ru":"Что-нибудь ещё?","hint_uk":"Бажаєте ще щось? / Ще щось?","options":[{"text": "Nee, das war's. Danke!", "type": "perfect", "feedback_ru": "Браво! Как местный 🇩🇪", "feedback_uk": "Браво! Як місцевий 🇩🇪"}, {"text": "Nein, ich benötige keine weiteren Artikel, vielen herzlichen Dank.", "type": "formal", "feedback_ru": "Диплом по немецкому, но не для кафе 🎓", "feedback_uk": "Диплом з німецької, але не для кафе 🎓"}, {"text": "Nein.", "type": "rude", "feedback_ru": "Можно же поприветливее 😐", "feedback_uk": "Можна ж привітніше 😐"}],"timer_sec":10,"level":"A1","sort_order":5,"created_at":"2026-03-03T09:38:43.464195+00:00","target_language":"de"}, {"id":"1d7ea01a-74f8-491d-b85e-26e10e893681","barista_line":"Was darf's sein?","hint_ru":"Что желаете?","hint_uk":"Що бажаєте?","options":[{"text": "Einen Kaffee, bitte!", "type": "perfect", "feedback_ru": "Идеально! Естественно и вежливо 👌", "feedback_uk": "Ідеально! Природно і ввічливо 👌"}, {"text": "Ich möchte gerne einen Kaffee bestellen.", "type": "formal", "feedback_ru": "Слишком формально для кафе 🤓", "feedback_uk": "Занадто формально для кафе 🤓"}, {"text": "Kaffee. Schnell.", "type": "rude", "feedback_ru": "Ого, это грубо! Так не говорят 😬", "feedback_uk": "Ого, це грубо! Так не кажуть 😬"}],"timer_sec":10,"level":"A1","sort_order":1,"created_at":"2026-03-03T09:38:43.464195+00:00","target_language":"de"}]
